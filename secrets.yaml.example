wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# This device's id on the render server (must match an id registered
# there) — shared across all yamls. Flashing is always over USB one
# device at a time, so edit this by hand to match whichever physical
# device is on the wire before you compile/upload.
device_id: "your-device-id"
